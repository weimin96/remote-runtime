{
  "name": "codex-remote-ssh",
  "version": "0.99.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "install:local": "node ./scripts/install-local.mjs",
    "verify:local": "npm run check && npm run install:local"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@openai/mcp-extensions": "0.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "body-parser": "2.2.2",
    "raw-body": "3.0.1"
  }
}

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_PUBLIC_URL=http://127.0.0.1:8000
GATEWAY_DATA_DIR=data
GATEWAY_SESSION_DAYS=30
GATEWAY_ENROLLMENT_MINUTES=30
GATEWAY_MAX_COMMAND_TIMEOUT=3600
# Set this to expose the Codex-style local MCP toolset (exec_command, write_stdin, apply_patch).
# Commands run as the Gateway OS user. Use / only when full-host access is intentional.
# Local mode is single-owner: bootstrap once with `python -m gateway.bootstrap_owner owner@example.com`.
# For public deployment use an HTTPS GATEWAY_PUBLIC_URL, Secure Cookies, and bind the app to 127.0.0.1 behind a reverse proxy.
# GATEWAY_LOCAL_WORKDIR=/srv
# Optional additional allowed roots. On Linux/macOS separate paths with ':'; on Windows use ';'.
# GATEWAY_LOCAL_WORKDIRS=/opt/apps:/data/repos
# Public local-runtime deployments must execute commands as a different OS user.
# GATEWAY_LOCAL_EXEC_USER=remote-agent-runner
# Production HTTPS deployments should set this to true.
GATEWAY_SECURE_COOKIES=false

